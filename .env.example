# Optional checkout settings. Store tokens and account ID once in
# %USERPROFILE%\.trading_engine\credentials.env, or set ENGINE_CREDENTIALS_FILE
# to your existing private local file. Keep both private files out of Git.

# Get this from your Tradier account: Settings -> API Access -> Access Token.
# Use your SANDBOX token while testing (paper data, no real trades) -- see
# https://documentation.tradier.com/brokerage-api/overview/authentication
# Sandbox and production tokens are different values from different accounts.
TRADIER_ACCESS_TOKEN=

# "sandbox" or "production". Controls which Tradier base URL main.py uses,
# AND which transport it picks: sandbox has NO streaming market data access
# at all (Tradier's documented limitation) -- main.py
# requires TRADIER_LIVE_DATA_TOKEN when TRADIER_ENV=sandbox.
TRADIER_ENV=sandbox

# For live-price triggers while placing SANDBOX orders, use your separately
# entitled production market-data token. It reads quotes/chains and opens a
# market-data stream; all orders still use the sandbox token above.
TRADIER_LIVE_DATA_TOKEN=

# These 12 symbols are watched by default, including on existing installs.
# WATCH_SYMBOLS can add extra symbols without replacing the default universe.
WATCH_SYMBOLS=SPY,QQQ,IWM,TSLA,NVDA,AAPL,AMD,AMZN,META,MSFT,GOOGL,NFLX

# Sandbox account ID, distinct from the token. Setting it enables sandbox
# option order preview, submission and fill reconciliation. Production
# account IDs are refused. Leave blank for internal simulation only.
TRADIER_ACCOUNT_ID=

# Durable sandbox order state. Keep this file across restarts; do not delete
# it while orders or positions are active. Unknown orders stay blocked.
SANDBOX_ORDER_JOURNAL=sandbox_orders.json

# Number of option contracts per order. No real position-sizing logic
# exists yet -- this is a fixed quantity, not a risk-based decision.
ORDER_QUANTITY=1
MAX_ORDER_DEBIT=300
MAX_TOTAL_DEBIT=600
MAX_DAILY_LOSS=500
MAX_ENTRY_SLIPPAGE_PCT=5

# Get this from your Unusual Whales account settings (API access).
# If left blank, main.py runs with Tradier alone -- UW confluence reads in
# entry_pipeline.py will show NOT_READY (treated as "no opinion", not an
# error). See trading_engine/uw_stream.py's module docstring before trusting
# this with anything real -- it is the least-verified piece of this bundle.
UW_API_KEY=
# Override only with the WebSocket URL supplied for your UW API access.
# A disconnected UW feed stays NOT_READY; it cannot confirm a trade.
# UW_WS_URL=wss://api.unusualwhales.com/socket
# Daily JSONL audit and EOD reports (local directory, ET dates).
ENGINE_LOG_DIR=logs
POST_EXIT_OBSERVE_SEC=600
OPTION_QUOTE_TIMEOUT_SEC=20
