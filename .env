# Public non-secret engine settings. Keep tokens/account IDs in your private
# %USERPROFILE%\.trading_engine\credentials.env or ENGINE_CREDENTIALS_FILE.
# Process environment variables take priority. Restart after editing.
TRADIER_ENV=sandbox
WATCH_SYMBOLS=SPY,QQQ,IWM,TSLA,NVDA,AAPL,AMD,AMZN,META,MSFT,GOOGL,NFLX
ORDER_QUANTITY=1
MAX_ORDER_DEBIT=6000
MAX_TOTAL_DEBIT=6000
MAX_DAILY_LOSS=500
MAX_ENTRY_SLIPPAGE_PCT=5
SANDBOX_ORDER_JOURNAL=sandbox_orders.json
ENGINE_LOG_DIR=logs
POST_EXIT_OBSERVE_SEC=600
OPTION_QUOTE_TIMEOUT_SEC=20
REVERSAL_PHASE_EXIT=true
STALL_EXIT_ENABLED=false
REVERSAL_MOMENTUM_DISPLAY=Completed
REVERSAL_SUPPORT_RESISTANCE=true
REVERSAL_LEVEL_STYLE=Step Line w/ Diamonds
REVERSAL_MOMENTUM_RISK=false
REVERSAL_EXHAUSTION_DISPLAY=Completed
REVERSAL_EXHAUSTION_RISK=false
REVERSAL_EXHAUSTION_TARGET=false
REVERSAL_TRADE_SETUPS=None
REVERSAL_SETUP_WARNINGS=false
